# OpenAI-compatible chat completion endpoint. Secrets stay on the server.
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4.1-mini
# A public Greenhouse board token, e.g. your chosen company's board slug.
GREENHOUSE_BOARD=
PORT=8000

# Set to 1 only when deploying behind HTTPS. Leave 0 for localhost.
COOKIE_SECURE=0
